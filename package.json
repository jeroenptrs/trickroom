{
	"name": "trickroom",
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/jeroenptrs/trickroom.git"
	},
	"scripts": {
		"dev": "pnpm generate:tailwind-tokens && vite",
		"build": "pnpm build:web-runtime && pnpm build:server && pnpm build:mcp",
		"build:web-runtime": "pnpm generate:tailwind-tokens && tsc && vite build",
		"build:server": "vite build --config vite.server.config.ts",
		"build:mcp": "vite build --config vite.mcp.config.ts",
		"preview": "vite preview",
		"generate:tailwind-tokens": "node --experimental-strip-types scripts/generate-tailwind-tokens.ts",
		"test": "vitest run",
		"typecheck": "tsc -b"
	},
	"devDependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
		"@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^2.1.5",
		"@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
		"@atlaskit/pragmatic-drag-and-drop-live-region": "^1.3.4",
		"@base-ui/react": "^1.5.0",
		"@biomejs/biome": "2.4.14",
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@fontsource/ibm-plex-sans": "^5.2.8",
		"@hono/node-server": "^2.0.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@tailwindcss/browser": "^4.2.4",
		"@tailwindcss/vite": "^4.2.4",
		"@tanstack/react-hotkeys": "^0.10.0",
		"@tanstack/react-query": "^5.100.10",
		"@tanstack/react-store": "^0.11.0",
		"@tanstack/react-virtual": "^3.13.25",
		"@types/node": "^24",
		"@types/react": "^19.2.3",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"cmdk": "^1.1.1",
		"fflate": "^0.8.3",
		"hono": "^4.12.14",
		"lucide-react": "^1.16.0",
		"lucide-static": "^1.16.0",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"react-frame-component": "^5.3.2",
		"react-router": "^7.14.2",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.4",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.10",
		"vitest": "^4.1.5",
		"zod": "^4.4.3"
	},
	"files": [
		"bin",
		"dist"
	],
	"bin": {
		"trickroom": "./bin/trickroom.js"
	},
	"dependencies": {
		"chokidar": "^5.0.0"
	}
}
